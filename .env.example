LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=
LLM_MODEL=
# Optional Ultramarine; unset or incomplete uses LLM_*.
DEEP_BASE_URL=
DEEP_API_KEY=
DEEP_MODEL=
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# USD per million tokens; TTS per 1,000 characters.
FAST_PRICE_IN=0
FAST_PRICE_OUT=0
DEEP_PRICE_IN=0
DEEP_PRICE_OUT=0
TTS_PRICE_PER_1K_CHARS=0
LLM_TIMEOUT=90
LLM_MAX_TOKENS=3500
LLM_RATE_LIMIT_MAX_WAIT=60
DATA_DIR=data
MAX_PDF_PAGES=80
MAX_GENERATION_SECTIONS=20
PORT=8000

# Hard limits per database / generation job. Browser speech remains available.
TTS_CHARACTER_BUDGET=8000
MAX_LLM_CALLS_PER_JOB=60
# Optional deployment credential; never sent to the app or committed.
RENDER_API_KEY=
MAX_CREATE_JOBS_PER_DAY=20
RENDER_OWNER_ID=

# GitHub OAuth (CLIENT_ID / CLIENT_SECRET aliases accepted).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_BASE_URL=http://127.0.0.1:8000
HOST_STORAGE_EPHEMERAL=true
MAX_PAPERS_PER_USER_DAY=3
MAX_TUTOR_JOBS_PER_USER_DAY=20
MAX_TUTOR_JOBS_PER_DAY=60
